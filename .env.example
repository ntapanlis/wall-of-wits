# Copy these into the hosting platform's environment-variable settings
# (e.g. Vercel Project Settings -> Environment Variables). Never commit
# real values — this file only documents the names.

# Service account email, e.g. wall-of-wits@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The service account's private key from its downloaded JSON key file,
# with real newlines replaced by literal \n (most hosting UIs do this
# for you automatically if you paste the whole key block).
GOOGLE_PRIVATE_KEY=

# The Sheet ID from its URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
SHEET_ID=

# Any long random string of your choosing. Required to view /api/validate.
ADMIN_TOKEN=
